# Адреса внешних сервисов (FR-15). Скопируйте файл в .env и при необходимости поменяйте значения.
# Чтобы перейти с mock-сервиса на рабочий, достаточно поменять адрес здесь: код менять не нужно.
# После изменения .env перезапустите `npm run dev`.
#
# Для локальной разработки и проверки агентом Cursor оставляйте адреса ниже.
# Стенды в корпоративной сети (доступны только по VPN) указывайте только
# в своём локальном .env — в .env.example их не коммитьте.

# Mock ML API: POST /diagnose
VITE_MOCK_ML_URL=http://127.0.0.1:8001

# Mock ТОиР: POST /tickets
VITE_MOCK_TOIR_URL=http://127.0.0.1:8002

# ИИ-агент: полный адрес вебхука, на него уходит POST с вопросом механика.
# Адрес выдаёт команда агента. Указывайте его только в своём локальном .env.
# Пока значение пустое, помощник в диалоге не отвечает, остальное работает.
VITE_AGENT_URL=
