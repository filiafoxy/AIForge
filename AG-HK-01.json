    {
      "parameters": {
        "jsCode": "const data = $input.last().json\nconst binaryData = $input.last().binary\n\nlet output = []\n\n// Проверяем есть ли бинарные данные\nif (binaryData && Object.keys(binaryData).length > 0) {\n  // Обрабатываем файлы если они есть\n  Object.keys(binaryData).forEach( b => {\n    // Добавляем реальное имя файла в body\n    const enrichedData = {\n      ...data,\n      body: {\n        ...data.body,\n        fileName: binaryData[b].fileName,\n      }\n    }\n    \n    output.push({\n      json: enrichedData,\n      binary: { data: binaryData[b]}\n    })\n  })\n} else {\n  // Возвращаем исходный запрос без изменений\n  output.push({\n    json: data,\n    binary: $input.last().binary\n  })\n}\n\nreturn output"
      },
